{
  "name": "@smurfelite/types",
  "version": "1.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./prisma": {
      "types": "./src/generated/prisma/index.d.ts",
      "import": "./src/generated/prisma/index.js",
      "default": "./src/generated/prisma/index.js"
    },
    "./src/generated/prisma/index.js": "./src/generated/prisma/index.js",
    "./pricing": {
      "types": "./pricing.ts",
      "import": "./pricing.ts",
      "default": "./pricing.ts"
    }
  },
  "files": [
    "index.ts",
    "pricing.ts",
    "src/enums.ts",
    "src/generated"
  ],
  "scripts": {
    "build": "pnpm --filter=@smurfelite/express-server prisma generate"
  }
}
