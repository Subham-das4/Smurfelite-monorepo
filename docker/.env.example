# Copy to docker/.env before: docker compose up
# Local Docker uses HTTP on port 80; use HTTPS URLs in production with TLS certs on nginx.

# --- PostgreSQL ---
POSTGRES_USER=smurfelite
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=smurfelite

# --- Public origins (no trailing slash on API base) ---
WWW_ORIGIN=http://www.smurfelite.store
API_ORIGIN=http://api.smurfelite.store
ADMIN_ORIGIN=http://admin.smurfelite.store
SELLER_ORIGIN=http://seller.smurfelite.store

# --- Frontend build-time API URL (include /api suffix) ---
NEXT_PUBLIC_EXPRESS_SERVER_API=http://api.smurfelite.store/api
VITE_EXPRESS_SERVER_API=http://api.smurfelite.store/api

# --- Express server (runtime) ---
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://smurfelite:change-me-postgres@postgres:5432/smurfelite
FRONTEND_URL=http://www.smurfelite.store
ADMIN_FRONTEND_URL=http://admin.smurfelite.store
SELLER_FRONTEND_URL=http://seller.smurfelite.store
ALLOWED_CORS_ORIGINS=http://www.smurfelite.store,http://admin.smurfelite.store,http://seller.smurfelite.store
FRONTEND_URLS=http://www.smurfelite.store,http://admin.smurfelite.store,http://seller.smurfelite.store
PUBLIC_API_BASE_URL=http://api.smurfelite.store

JWT_SECRET=change-me-jwt-secret-min-32-chars
SALT_ROUNDS=10
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Google OAuth (optional — register redirect URIs per subdomain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://api.smurfelite.store/api/auth/google/callback

# Payments (optional for local stack smoke)
PAYMENT_BYPASS=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Vite portals
VITE_APP_NAME_ADMIN=Admin Panel
VITE_APP_NAME_SELLER=Seller Portal
VITE_PERSIST_SECRET=change-me-persist-secret
VITE_GOOGLE_CLIENT_ID=

# Cron
LOG_LEVEL=info
WALLET_HOLD_DAYS=7
WALLET_RELEASE_CRON=0 * * * *
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_EXPIRY_CRON=*/10 * * * *
EMBEDDING_BACKFILL_ENABLED=false
CRON_ADVISORY_LOCK_ID=810000001
