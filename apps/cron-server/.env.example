# Same database as express-server (required)
DATABASE_URL="postgresql://user:password@localhost:5432/smurfelite"

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Wallet hold release (Phase 8.2)
WALLET_HOLD_DAYS=7
WALLET_RELEASE_CRON="0 * * * *"

# Order expiry (Phase 8.2) — align with express ORDER_PENDING_TIMEOUT_MINUTES
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_EXPIRY_CRON="*/10 * * * *"

# Embedding backfill (Phase 8.2, optional)
EMBEDDING_BACKFILL_ENABLED=false
EMBEDDING_BATCH_SIZE=10
EMBEDDING_BACKFILL_CRON="0 3 * * *"

# Postgres advisory lock key (single cron instance)
CRON_ADVISORY_LOCK_ID=810000001
