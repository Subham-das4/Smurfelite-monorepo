# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smurfelite"

# Server
PORT=8080
FRONTEND_URL="http://localhost:3000"

# Public origin of this API (no trailing slash). Used for NOWPayments IPN callback URLs.
# Local dev: use an HTTPS tunnel (ngrok, Cloudflare Tunnel) — NOWPayments cannot POST to localhost.
# Example: https://abc123.ngrok.io
PUBLIC_API_BASE_URL="https://your-tunnel.example.com"

# NOWPayments (sandbox: https://api-sandbox.nowpayments.io/v1)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Optional override; defaults to sandbox API when unset.
# NOWPAYMENTS_API_BASE_URL="https://api-sandbox.nowpayments.io/v1"

# Dev/E2E: skip NOWPayments and auto-complete orders (never enable in production)
PAYMENT_BYPASS=false

# Unpaid PENDING orders auto-cancel after this many minutes (inline on fetch; cron in Phase 8)
ORDER_PENDING_TIMEOUT_MINUTES=30
