# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smurfelite"

# Server
PORT=8080
FRONTEND_URL="http://localhost:3000"
# Admin panel origin for password-reset links (Phase 10.3); smoke uses SMOKE_ADMIN_EMAIL/PASSWORD
ADMIN_FRONTEND_URL="http://localhost:5173"
# Seller portal origin for invite links (Phase 10.5)
SELLER_FRONTEND_URL="http://localhost:5174"
# CORS: set ALLOWED_CORS_ORIGINS or FRONTEND_URLS (comma-separated buyer + portal apps)
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
FRONTEND_URLS="http://localhost:3000,http://localhost:5173,http://localhost:5174"

# Dev-only startup seeds (skipped when NODE_ENV=production) — see ensureAdminUser in src/lib/prisma.ts
# DEFAULT_ADMIN_EMAIL=admin@admin.com
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_BUYER_EMAIL=buyer@buyer.com
# DEFAULT_BUYER_PASSWORD=buyer123
# DEFAULT_SELLER_EMAIL=seller@seller.com
# DEFAULT_SELLER_PASSWORD=seller123

# Public origin of this API (no trailing slash). Used for NOWPayments IPN callback URLs.
# Local dev: use an HTTPS tunnel (ngrok, Cloudflare Tunnel) — NOWPayments cannot POST to localhost.
# Example: https://abc123.ngrok.io
PUBLIC_API_BASE_URL="https://your-tunnel.example.com"

# NOWPayments (sandbox: https://api-sandbox.nowpayments.io/v1)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Optional override; defaults to sandbox API when unset.
# NOWPAYMENTS_API_BASE_URL="https://api-sandbox.nowpayments.io/v1"

# Dev/E2E: skip NOWPayments and auto-complete orders (never enable in production)
PAYMENT_BYPASS=false

# Unpaid PENDING orders auto-cancel after this many minutes (inline on fetch; cron in Phase 8)
ORDER_PENDING_TIMEOUT_MINUTES=30

# SMTP (shared host/port; credentials per sender below)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Sender identities — address, display name, and SMTP login per mailbox
EMAIL_FINANCE_ADDRESS=finance@smurfelite.store
EMAIL_FINANCE_NAME=SmurfElite Finance
EMAIL_FINANCE_USER=
EMAIL_FINANCE_PASS=

EMAIL_HELP_ADDRESS=help@smurfelite.store
EMAIL_HELP_NAME=SmurfElite Support
EMAIL_HELP_USER=
EMAIL_HELP_PASS=

EMAIL_PURCHASE_ADDRESS=purchase@smurfelite.store
EMAIL_PURCHASE_NAME=SmurfElite Purchases
EMAIL_PURCHASE_USER=
EMAIL_PURCHASE_PASS=
