{
  "name": "smurfelite-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start:dev": "concurrently \"pnpm --filter=@smurfelite/express-server dev\" \"pnpm --filter=nextjs-app dev\"",
    "dev:express": "pnpm --filter=@smurfelite/express-server dev",
    "dev:nextjs": "pnpm --filter=nextjs-app dev",
    "smoke:through-1": "pnpm --filter=@smurfelite/express-server smoke:through-1",
    "smoke:through-2.1": "pnpm --filter=@smurfelite/express-server smoke:through-2.1",
    "smoke:through-2.2": "pnpm --filter=@smurfelite/express-server smoke:through-2.2",
    "smoke:through-2.3": "pnpm --filter=@smurfelite/express-server smoke:through-2.3",
    "smoke:through-2.5": "pnpm --filter=@smurfelite/express-server smoke:through-2.5",
    "smoke:through-3.1": "pnpm --filter=@smurfelite/express-server smoke:through-3.1",
    "smoke:through-3.2": "pnpm --filter=@smurfelite/express-server smoke:through-3.2",
    "smoke:through-3.3": "pnpm --filter=@smurfelite/express-server smoke:through-3.3",
    "smoke:phase-2.5": "pnpm --filter=@smurfelite/express-server smoke:phase-2.5",
    "smoke:phase-3.1": "pnpm --filter=@smurfelite/express-server smoke:phase-3.1",
    "smoke:phase-3.2": "pnpm --filter=@smurfelite/express-server smoke:phase-3.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
