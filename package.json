{
  "name": "smurfelite-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start:dev": "concurrently \"pnpm --filter=@smurfelite/express-server dev\" \"pnpm --filter=nextjs-app dev\""
  },
  "keywords": [],
